# =============================================================================
# LinksMooveHub — variáveis para o hPanel (Hostinger)
# Copie para .env localmente. No servidor: Import from .env file no deploy.
# =============================================================================

# NÃO defina PORT no hPanel — a Hostinger injeta automaticamente.
# PORT=3000

NODE_ENV=production

# -----------------------------------------------------------------------------
# Hostinger — Painel admin (OBRIGATÓRIO em produção)
# -----------------------------------------------------------------------------

ADMIN_USERNAME=admin
ADMIN_PASSWORD=altere_para_senha_forte_e_unica

# URL pública do site (sem barra no final)
PUBLIC_URL=https://seu-dominio.com.br

# -----------------------------------------------------------------------------
# Hostinger — Banco de dados (escolha UMA opção)
# -----------------------------------------------------------------------------

# Opção A — SQLite (plano Node + pasta data/ com permissão de escrita)
DATABASE_URL=file:./data/links.db

# Opção B — PostgreSQL (hPanel → Bancos de dados → PostgreSQL)
# DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/NOME_DO_BANCO
# DATABASE_SSL=true

# -----------------------------------------------------------------------------
# Geolocalização (geoip-lite)
# -----------------------------------------------------------------------------

GEOIP_LOCAL_FALLBACK=Região de Teste

# -----------------------------------------------------------------------------
# Opcional
# -----------------------------------------------------------------------------

# TZ=America/Sao_Paulo
